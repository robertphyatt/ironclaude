{
  "poll_interval_seconds": 15,
  "heartbeat_interval_seconds": 900,
  "max_swap_used_gb": 50,
  "spawn_block_pressure_level": 4,
  "worker_stale_threshold_seconds": 300,
  "brain_heartbeat_timeout_seconds": 60,
  "max_worker_retries": 3,
  "machines": [
    {"name": "laptop", "url": "http://localhost:11434", "model": "qwen3-coder-next:q2_k", "max_workers": 1}
  ],
  "tmp_dir": "/tmp/ic",
  "log_dir": "/tmp/ic-logs",
  "advisor": {
    "enabled": true,
    "executor_model": "sonnet",
    "advisor_model": "opus"
  },
  "providers": {
    "clients": {
      "codex": {
        "enabled": true
      }
    },
    "roles": {
      "worker": {"preferred": "codex", "clients": ["codex", "claude"]},
      "grader": {"preferred": "codex", "clients": ["codex", "claude"]}
    }
  }
}
