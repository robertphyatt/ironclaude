{
  "description": "Professional mode enforcement, plan execution monitoring, drift detection, and episodic memory sync",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/session-init.sh"
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/episodic-memory-sync.sh --background"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/episodic-memory-reminder.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/ironclaude-hooks/codex-brain-gated-actions.sh"
          }
        ],
        "matcher": "mcp__(plugin_ironclaude_)?episodic[-_]memory__.*|mcp__plugin_ironclaude_orchestrator__(wiki_query|get_operator_messages|update_ledger|spawn_worker|spawn_workers|approve_plan|reject_plan|send_to_worker|kill_worker|game_(launch|screenshot|click|type|key|kill))|mcp__orchestrator__(wiki_query|get_operator_messages|update_ledger|spawn_worker|spawn_workers|approve_plan|reject_plan|send_to_worker|kill_worker|game_(launch|screenshot|click|type|key|kill))|mcp__plugin_ironclaude_ollama__(pull_model|remove_model|create_model)|mcp__ollama__(pull_model|remove_model|create_model)"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/ironclaude-hooks/skill-state-bridge.sh"
          }
        ],
        "matcher": "Skill"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/ironclaude-hooks/plan-task-context.sh"
          }
        ],
        "matcher": "Read|Grep|Glob|Edit|Write|NotebookEdit|MultiEdit|Bash|Task"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/ironclaude-hooks/professional-mode-guard.sh"
          }
        ],
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Bash|Read|Grep|Glob|apply_patch|exec_command"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/ironclaude-hooks/subagent-circuit-breaker.sh"
          }
        ],
        "matcher": "Task"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/ironclaude-hooks/poll-dedup.sh"
          }
        ],
        "matcher": "Read|Bash|Grep|Glob"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/ironclaude-hooks/task-completion-validator.sh"
          }
        ],
        "matcher": "Skill"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/ironclaude-hooks/subagent-circuit-breaker.sh"
          }
        ],
        "matcher": "Task"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/ironclaude-hooks/memory-search-tracker.sh"
          }
        ],
        "matcher": "Task"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/ironclaude-hooks/subagent-circuit-breaker.sh"
          }
        ],
        "matcher": "TaskOutput"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/ironclaude-hooks/mcp-state-logger.sh"
          }
        ],
        "matcher": "mcp__(plugin_ironclaude_)?state[-_]manager__(mark_design_ready|mark_plan_ready|mark_brainstorming|mark_executing|mark_debugging|create_plan|start_execution|retreat)"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/ironclaude-hooks/poll-dedup.sh"
          }
        ],
        "matcher": "Read|Bash|Grep|Glob"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/ironclaude-hooks/state-activator.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/ironclaude-hooks/plan-execution-reminder.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/ironclaude-hooks/subagent-drift-detector.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/ironclaude-hooks/get-back-to-work-claude.sh"
          }
        ]
      }
    ]
  }
}
