{
  "name": "workspace-manager",
  "version": "1.1.5",
  "description": "Managed Git worktree lifecycle MCP server for IronClaude",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "npm run bundle:server && npm run bundle:cli && npm run bundle:hook-intent",
    "bundle:server": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:fsevents --external:better-sqlite3",
    "bundle:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --external:fsevents --external:better-sqlite3",
    "bundle:hook-intent": "esbuild src/hook-intent.ts --bundle --platform=node --format=esm --outfile=dist/hook-intent.js --external:fsevents --external:better-sqlite3",
    "postinstall": "npm rebuild better-sqlite3 2>/dev/null || true",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "ironclaude",
    "git-worktree",
    "mcp-server"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.22.0",
    "better-sqlite3": "^12.4.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.7.0",
    "esbuild": "^0.25.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
