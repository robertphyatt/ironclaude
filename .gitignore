# Node.js — node_modules auto-installed by wrapper on first run
# Only source code and config committed; deps + build artifacts are generated
node_modules/
*.db
.tmp.driveupload
.tmp.drivedownload

# Commander (Python)
__pycache__/
*.pyc
commander/src/ironclaude/plugins/scan/
commander/src/ironclaude/plugins/game
commander/.env
config/machines.yaml
commander/data/db/*.db
commander/data/db/*.db-shm
commander/data/db/*.db-wal
*.egg-info/
commander/dist/
build/
.pytest_cache/
.venv/
/tmp/ic-*

# Workflow artifacts (generated by professional mode, not user-facing)
docs/

# Worker MCP server build artifacts (generated by wrapper on first run)
worker/mcp-servers/*/dist/
scan

# Local Claude Code settings (not committed)
.claude/settings.local.json

# Personal runtime config (gitignored — copy from config/ironclaude.json.example)
config/ironclaude.json
